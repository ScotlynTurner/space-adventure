{{define "content"}}
<section class="story" aria-labelledby="story-title">
    <p class="eyebrow">Story in progress</p>
    <h1 id="story-title">Your next chapter</h1>
    {{if .Story}}
        <p>{{.Story.Description}}</p>
        {{if .Story.Image}}
            <img class="story-image" src="{{.Story.Image}}" alt="Story scene">
        {{else}}
            <p class="placeholder">Story artwork will go here.</p>
        {{end}}
        <div class="choices" aria-label="Story choices">
            <h2>What do you do?</h2>
            <ul>
                {{range .Story.Choices}}
                    <li><button class="button" type="button" disabled>{{.Label}}</button></li>
                {{else}}
                    <li class="placeholder">No choices have been added yet.</li>
                {{end}}
            </ul>
            <!-- TODO: Make each choice load its NextNodeID. -->
        </div>
    {{else}}
        <p class="placeholder">No story node is available.</p>
    {{end}}
</section>
{{end}}
