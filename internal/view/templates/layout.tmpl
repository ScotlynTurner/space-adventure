<!doctype html>
<html lang="en">
{{ define "Layout" }}
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.Title}} | Space Adventure</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist+Pixel&family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
    <div class="stars" aria-hidden="true"></div>
    <div class="twinkling" aria-hidden="true"></div>
    <div class="clouds" aria-hidden="true"></div>
    <header class="site-header">
        <a class="site-title" href="/">Space Adventure</a>
        <nav aria-label="Main navigation">
            <a href="/">Home</a>
            <a href="/achievements">Achievements</a>
        </nav>
    </header>
    <main id="main-content">
        {{block "content" .}}{{end}}
    </main>
    <script src="/scripts/app.js" defer></script>
</body>
{{ end }}
</html>
